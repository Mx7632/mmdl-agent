# Application
APP_APP_NAME=industrial-anomaly-agent
APP_LOG_LEVEL=INFO
APP_ENABLE_TRACING=false

# Security and browser access
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_REQUIRE_API_TOKEN=false
APP_API_TOKEN=

# Runtime state and review workflow
APP_LOW_CONFIDENCE_REVIEW_THRESHOLD=0.75
APP_RUNTIME_STORE_PATH=data/runtime/industrial_state.json

# LangGraph checkpoint storage
APP_CHECKPOINT_BACKEND=memory
# APP_CHECKPOINT_BACKEND=postgres
APP_DATABASE_URL=postgresql://mmdl_user:123456@localhost:5432/mmdl_agent
APP_DATABASE_SCHEMA=public

# LLM provider: DashScope OpenAI-compatible API
# Never commit a real API key.
APP_OPENAI_API_KEY=
APP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_LLM_MODEL=qwen3.5-plus
APP_LLM_VISION_MODEL=qwen3.5-plus
APP_LLM_TEMPERATURE=0.3
APP_LLM_TIMEOUT=60
APP_LLM_MAX_TOKENS=500
APP_QWEN_MIN_ANOMALY_SCORE=0.65

# Default visual anomaly backend
# Supported values: grad, patchcore, qwen, anomalygpt
APP_VISION_DETECTOR_BACKEND=grad

# GRAD sidecar
APP_GRAD_DETECTOR_URL=http://127.0.0.1:9011/detect
APP_GRAD_DETECTOR_TIMEOUT=180
APP_GRAD_DETECTOR_ALIASES=grad,bi_grid,bi-grid

# Optional AnomalyGPT or professional detector sidecar
APP_PROFESSIONAL_VISION_DETECTOR_TYPE=anomalygpt
APP_PROFESSIONAL_VISION_DETECTOR_URL=
APP_PROFESSIONAL_VISION_DETECTOR_TIMEOUT=30
APP_PROFESSIONAL_VISION_DETECTOR_ALIASES=anomalygpt,anomaly_gpt,specialist-http,specialist_http,professional

# Optional generic time-series anomaly detector
APP_ANOMALY_DETECTION_URL=http://localhost:8080/
APP_ANOMALY_DETECTION_TIMEOUT=30

# Optional local PatchCore backend
APP_PATCHCORE_MODEL_ROOT=models/patchcore
APP_PATCHCORE_HEATMAP_DIR=data/heatmaps
APP_PATCHCORE_DEFAULT_CATEGORY=bottle
APP_PATCHCORE_THRESHOLD=0.95
APP_PATCHCORE_IMAGE_SIZE=256
APP_PATCHCORE_DEVICE=cpu
APP_PATCHCORE_BACKBONE=resnet18
APP_PATCHCORE_PRETRAINED_BACKBONE=true
APP_GRAD_CHECKPOINT_DIR=models/grad
APP_GRAD_DEVICE=cpu
APP_GRAD_DEFAULT_CATEGORY=bottle
APP_GRAD_THRESHOLD=0.5
APP_GRAD_HEATMAP_DIR=data/heatmaps
APP_GRAD_DETECTOR_ALIASES=grad,grad_anomaly,grad_ad

APP_PATCHCORE_MAX_MEMORY_BANK=10000
APP_PATCHCORE_DETECTOR_ALIASES=patchcore,patch_core

# RAG
APP_RAG_ENABLED=true
APP_RAG_DATASET_ROOT=data_sets/mvtec_anomaly_detection
APP_RAG_VECTOR_DIR=data/rag/chroma
APP_RAG_METADATA_PATH=data/rag/dataset_metadata.json
APP_RAG_DESCRIPTIONS_PATH=data/rag/anomaly_descriptions.json
APP_RAG_TOP_K=3
APP_RAG_LEARNING_THRESHOLD=0.85
APP_RAG_MULTIMODAL_EMBEDDING_MODEL=multimodal-embedding-v1
